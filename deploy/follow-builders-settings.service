[Unit]
Description=AI Builders Digest delivery-time settings
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/follow-builders/scripts
Environment=HOME=/home/ubuntu
Environment=FOLLOW_BUILDERS_HOME=/home/ubuntu/.follow-builders
EnvironmentFile=/home/ubuntu/.follow-builders/.settings.env
ExecStart=/usr/bin/node /home/ubuntu/follow-builders/scripts/settings-server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.follow-builders
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
